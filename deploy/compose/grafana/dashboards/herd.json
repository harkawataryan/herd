{
  "title": "Herd",
  "uid": "herd",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Time to first token (p50 / p99)", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "uid": "prom" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(herd_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(herd_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries", "title": "KV-cache utilization per replica", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "uid": "prom" },
      "targets": [ { "expr": "vllm:gpu_cache_usage_perc", "legendFormat": "{{model_name}}" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } }
    },
    {
      "type": "timeseries", "title": "Requests/s by backend", "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "datasource": { "uid": "prom" },
      "targets": [ { "expr": "sum(rate(herd_requests_total[1m])) by (backend)", "legendFormat": "{{backend}}" } ]
    },
    {
      "type": "timeseries", "title": "Scheduler decisions by reason", "gridPos": { "x": 8, "y": 8, "w": 8, "h": 7 },
      "datasource": { "uid": "prom" },
      "targets": [ { "expr": "sum(rate(herd_decisions_total[1m])) by (reason)", "legendFormat": "{{reason}}" } ]
    },
    {
      "type": "timeseries", "title": "Queue depth / shed / spillover", "gridPos": { "x": 16, "y": 8, "w": 8, "h": 7 },
      "datasource": { "uid": "prom" },
      "targets": [
        { "expr": "sum(herd_queue_depth) by (class)", "legendFormat": "queued {{class}}" },
        { "expr": "sum(rate(herd_shed_total[1m]))", "legendFormat": "shed/s" },
        { "expr": "sum(rate(herd_spillover_total[1m]))", "legendFormat": "spillover/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Waiting requests on replicas (server-side queue)", "gridPos": { "x": 0, "y": 15, "w": 12, "h": 7 },
      "datasource": { "uid": "prom" },
      "targets": [ { "expr": "vllm:num_requests_waiting", "legendFormat": "{{model_name}}" } ]
    },
    {
      "type": "timeseries", "title": "Cloud spend (USD)", "gridPos": { "x": 12, "y": 15, "w": 12, "h": 7 },
      "datasource": { "uid": "prom" },
      "targets": [ { "expr": "sum(herd_cost_usd_total) by (tenant)", "legendFormat": "{{tenant}}" } ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
